{
  "name": "@devdigest/mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DevDigest local MCP server (stdio). Thin layer over the running DevDigest HTTP API.",
  "bin": { "devdigest-mcp": "src/main.ts" },
  "scripts": {
    "start": "tsx src/main.ts",
    "inspect": "npx @modelcontextprotocol/inspector tsx src/main.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
