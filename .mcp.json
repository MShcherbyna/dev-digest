{
  "mcpServers": {
    "devdigest": {
      "type": "stdio",
      "command": "${CLAUDE_PROJECT_DIR:-.}/mcp/node_modules/.bin/tsx",
      "args": [
        "${CLAUDE_PROJECT_DIR:-.}/mcp/src/main.ts"
      ],
      "env": {
        "DEVDIGEST_API_URL": "${DEVDIGEST_API_URL:-http://localhost:3001}"
      }
    }
  }
}
